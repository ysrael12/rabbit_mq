@startuml
skinparam shadowing false
skinparam dpi 300
skinparam defaultFontName "Segoe UI"
skinparam defaultTextAlignment center
skinparam sequenceMessageAlign center
skinparam participant {
  BackgroundColor #EAF1FA
  BorderColor #1F3B5C
  FontColor #12314F
}
skinparam sequence {
  ArrowColor #45637F
  LifeLineBorderColor #9FB4CB
  GroupBorderColor #B85450
}
skinparam note {
  BackgroundColor #FFF9E6
  BorderColor #B8860B
}

title <size:17>Fluxo de uma imagem: conversao e replicacao por exchange fanout</size>\n<size:12>Diagrama de sequencia — ack manual e prefetch 1 explicam por que nenhum arquivo se perde</size>

actor "cliente1" as cl
participant "fila.originais\n<size:11>duravel</size>" as q
participant "conversor1" as cv
participant "exchange convertidas\n<size:11>fanout</size>" as ex
participant "fila storage.1" as qs1
participant "storage1" as st1
participant "fila storage.2" as qs2
participant "storage2" as st2

cl -> q : publica(nome_original, bytes) \n<size:11>mensagem persistente</size>
q -> cv : entrega 1 mensagem \n<size:11>prefetch 1</size>
activate cv
cv -> cv : to_luma8\n<size:11>save mantendo a extensao</size>
cv -> ex : publica(convertida)
deactivate cv
cv -> q : basic_ack\n<size:11>so confirma depois de converter</size>

group fanout: copia para todas as filas vinculadas
  ex -> qs1 : copia
  ex -> qs2 : copia
end

qs1 -> st1 : consome
qs2 -> st2 : consome
st1 -> st1 : grava /pastas-storage/storage1\n<size:11>mesmo nome, sem uuid</size>
st2 -> st2 : grava /pastas-storage/storage2\n<size:11>mesmo nome, sem uuid</size>

note over st1, st2
  Prova de redundancia (nao e o log que prova):
  ls /pastas-storage/storage*  -> mesmos nomes que o cliente enviou
  md5sum /pastas-storage/storage*  -> hashes iguais
  contador por execucao: publicadas x salvas em cada storage
end note
@enduml
