@startuml
skinparam shadowing false
skinparam dpi 130
skinparam defaultFontName "Segoe UI"
skinparam defaultTextAlignment center
skinparam nodesep 18
skinparam ranksep 30
skinparam arrowColor #45637F
skinparam componentStyle uml2
skinparam package {
  BackgroundColor #F4F7FB
  BorderColor #1F3B5C
}
skinparam component {
  BackgroundColor #EAF1FA
  BorderColor #1F3B5C
  FontColor #12314F
}
skinparam database {
  BackgroundColor #FDF0F0
  BorderColor #B85450
}

title <size:17>Componentes do binario unico (imagem Docker app) — um Dockerfile multi-stage, tres subcomandos</size>

package "imagem docker: app (rust:slim builder -> debian slim)" {

  component "binario app\n<size:11>dispatch por subcomando</size>" as app {
  }

  component "cliente\n<size:11>app cliente</size>" as cli {
  }
  component "conversor\n<size:11>app conversor</size>" as conv {
  }
  component "storage\n<size:11>app storage</size>" as stor {
  }

  component "amqp\n<size:11>lapin: conexao, fila duravel, ack manual, prefetch 1</size>" as amqp
  component "io_imagem\n<size:11>crate image 0.25: to_luma8 + save com nome original</size>" as img
  component "pasta_entrada / pasta_saida\n<size:11>caminhos vindos de variavel de ambiente</size>" as fs
}

cli --> amqp
cli --> fs
conv --> amqp
conv --> img
stor --> amqp
stor --> fs
@enduml
