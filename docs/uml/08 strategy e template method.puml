@startuml
' Diagrama 08 — comportamento/strategy + template_method
skinparam shadowing false
skinparam dpi 300
skinparam defaultFontName "Segoe UI"
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #EAF1FA
  BorderColor #1F3B5C
  FontColor #12314F
  AttributeFontSize 12
  AttributeFontColor #33475B
}
skinparam note {
  BackgroundColor #FFF9E6
  BorderColor #B8860B
}
hide circle
hide empty members

title <size:17>comportamento/strategy + template_method — o contrato dos tres papeis</size>

interface "Servico" as SERV <<trait>> {
  --
  + <b>executar(&mut self) : Res<u64></b>
  <size:11>template method: esqueleto pronto</size>
  {method} preparar(&mut self) : Res<()>
  {method} receber(&mut self) : Res<Vec<Vec<u8>>>
  {method} passo(&mut self, corpos: Vec<Vec<u8>>) : Res<usize>
  {method} confirmar(&mut self) : Res<()>
  {method} resumo(&self) : String
}

class "Cliente" as CLI <<struct>> {
  - broker : Broker
  - cfg : Config
  - assunto : Assunto
  + preparar() : Res<()>
  + passo(corpos) : Res<usize>
  + resumo() : String
}

class "Conversor" as CONV <<struct>> {
  - broker : Broker
  - cfg : Config
  - passo_img : Box<dyn Passo>
  - assunto : Assunto
  + preparar() : Res<()>
  + passo(corpos) : Res<usize>
  + resumo() : String
}

class "Storage" as STOR <<struct>> {
  - broker : Broker
  - cfg : Config
  - assunto : Assunto
  + preparar() : Res<()>
  + passo(corpos) : Res<usize>
  + resumo() : String
}

class "Config" as CFG <<comum/config>>
class "Broker" as FAC <<estrutural/facade>>
class "Assunto" as OBS <<comportamento/observer>>
interface "Passo" as PASSO <<estrutural/decorator>>
class "io_imagem" as IOM <<estrutural/adapter>>

CLI ..|> SERV
CONV ..|> SERV
STOR ..|> SERV

SERV ..> FAC
CONV ..> PASSO
CONV ..> IOM

note top of SERV
  executar() nao e reescrito por ninguem:
  preparar -> (receber -> passo -> confirmar) em laco -> resumo
  O ack acontece DEPOIS do passo, em um unico lugar.
end note

note right of CONV
  passo() do conversor:
  1 converte (via Passo/io_imagem)
  2 publica no exchange (fanout, via Broker)
  3 o template confirma a mensagem
  Se cair entre 2 e 3, a mensagem volta e o arquivo
  e reescrito com o MESMO nome — nao duplica nem corrompe.
end note

note bottom of CLI
  Cliente nao conhece Passo nem io_imagem:
  nao converte nada, so publica.
end note
@enduml
