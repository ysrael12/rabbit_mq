@startuml
' Diagrama 12 — estrutura entregue (camadas) e correspondencia com os padroes
skinparam shadowing false
skinparam dpi 300
skinparam defaultFontName "Segoe UI"
skinparam defaultTextAlignment center
skinparam arrowColor #2F4F6F
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam noteBackgroundColor #FFF8DC
skinparam noteBorderColor #B8860B
skinparam package {
  BackgroundColor #F3F6FA
  BorderColor #2F4F6F
  FontColor #1F3B5C
}
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #2F4F6F
  FontColor #1F3B5C
}

title Estrutura entregue: duas camadas, nao uma pasta por padrao (diagrama 06 x codigo)

package "main.rs" as MAIN {
  component "args -> Papel -> Config\ncriar(papel, cfg) -> Invocador::executar" as M
}

package "controladores/  (quem constroi e quem dispara)" as CTRL {
  component "criar.rs  [Factory Method]\nFabricaServico + FabricaReal\nFabricaFalsa (teste, em memoria)" as CRIAR
  component "invocador.rs  [Command]\nservico : Box(dyn Servico)\npedido : Papel" as INV
}

package "modelos/  (dominio + os padroes)" as MOD {
  component "Config.rs\nseis variaveis, um lugar" as CFG
  component "Mensagem.rs\n4 bytes BE + nome UTF-8 + bytes" as MSG
  component "Topologia.rs  [Mediator]\nnomes de fila e exchange, binds" as TOPO
  component "Cliente.rs  [Strategy]\npublica na fila.originais" as CLI
  component "Conversor.rs  [Strategy]\nconverte e publica no fanout" as CONV
  component "Storage.rs  [Strategy]\ngrava com o nome original" as STOR
  component "utils.rs  [Template Method]\ntrait Servico + executar()" as UTIL
  component "Broker.rs + PortaBroker.rs  [Facade + porta]\nunico arquivo que nomeia o lapin" as BRK
  component "io_imagem.rs  [Adapter]\ncrate image atras de converter(bytes)" as IMG
}

MAIN --> CRIAR : escolhe a familia
MAIN --> INV : cria o comando
CRIAR ..> CLI
CRIAR ..> CONV
CRIAR ..> STOR
CLI ..> UTIL : implementa Servico
CONV ..> UTIL : implementa Servico
STOR ..> UTIL : implementa Servico
CLI --> TOPO
CONV --> TOPO
STOR --> TOPO
CLI --> BRK : PortaBroker
CONV --> BRK : PortaBroker
STOR --> BRK : PortaBroker
CONV --> IMG : converter(bytes)
INV ..> UTIL : Box(dyn Servico)

note top of CTRL
  Desvio do diagrama 06: camadas em vez de pasta = padrao.
end note

note bottom of MOD
  Fora do codigo: Decorator e Observer (so no desenho 11).
end note
@enduml
